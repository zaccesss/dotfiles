# Zacess Warm Dark
# generated by scripts/build-themes.py from palette/zacess.json, do not edit by hand
# a fragment zt copies into nano's own rc file: nano accepts set only there, never in an include

set titlecolor bold,#211,#eb6
set statuscolor #211,#eb6
set promptcolor #211,#eb6
set minicolor #211,#eb6
set errorcolor bold,#211,#f98
set keycolor bold,#211,#eb6
set functioncolor #edb
set numbercolor #cba
set selectedcolor #211,#7bd
set spotlightcolor #edb,#530
set scrollercolor #cba
