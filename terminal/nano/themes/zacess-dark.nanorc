# Zacess Dark
# generated by scripts/build-themes.py from palette/zacess.json, do not edit by hand

set titlecolor bold,#111,#8bf
set statuscolor #111,#8bf
set promptcolor #111,#8bf
set minicolor #111,#8bf
set errorcolor bold,#111,#fa9
set keycolor bold,#111,#8bf
set functioncolor #fff
set numbercolor #ccc
set selectedcolor #111,#4bf
set spotlightcolor #fff,#440
set scrollercolor #ccc
