# Zacess Cream
# generated by scripts/build-themes.py from palette/zacess.json, do not edit by hand
# a fragment zt copies into nano's own rc file: nano accepts set only there, never in an include

set titlecolor bold,#fff,#049
set statuscolor #fff,#049
set promptcolor #fff,#049
set minicolor #fff,#049
set errorcolor bold,#ffe,#c00
set keycolor bold,#fff,#049
set functioncolor #000
set numbercolor #332
set selectedcolor #ffe,#70c
set spotlightcolor #000,#fd0
set scrollercolor #332
