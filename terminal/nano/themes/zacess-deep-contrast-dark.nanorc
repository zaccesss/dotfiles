# Zacess Deep Contrast Dark
# generated by scripts/build-themes.py from palette/zacess.json, do not edit by hand
# a fragment zt copies into nano's own rc file: nano accepts set only there, never in an include

set titlecolor bold,#000,#0ff
set statuscolor #000,#0ff
set promptcolor #000,#0ff
set minicolor #000,#0ff
set errorcolor bold,#000,#f55
set keycolor bold,#000,#0ff
set functioncolor #fff
set numbercolor #bbb
set selectedcolor #000,#f7f
set spotlightcolor #fff,#430
set scrollercolor #bbb
