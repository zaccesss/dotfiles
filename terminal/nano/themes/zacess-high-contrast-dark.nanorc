# Zacess High Contrast Dark
# generated by scripts/build-themes.py from palette/zacess.json, do not edit by hand

set titlecolor bold,#000,#fc0
set statuscolor #000,#fc0
set promptcolor #000,#fc0
set minicolor #000,#fc0
set errorcolor bold,#000,#f99
set keycolor bold,#000,#fc0
set functioncolor #fff
set numbercolor #eee
set selectedcolor #000,#b9f
set spotlightcolor #fff,#430
set scrollercolor #eee
