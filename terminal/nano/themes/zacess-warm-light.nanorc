# Zacess Warm Light
# generated by scripts/build-themes.py from palette/zacess.json, do not edit by hand
# a fragment zt copies into nano's own rc file: nano accepts set only there, never in an include

set titlecolor bold,#fed,#630
set statuscolor #fed,#630
set promptcolor #fed,#630
set minicolor #fed,#630
set errorcolor bold,#fed,#811
set keycolor bold,#fed,#630
set functioncolor #321
set numbercolor #432
set selectedcolor #fed,#257
set spotlightcolor #321,#fc3
set scrollercolor #432
