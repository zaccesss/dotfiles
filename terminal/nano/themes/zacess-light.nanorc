# Zacess Light
# generated by scripts/build-themes.py from palette/zacess.json, do not edit by hand

set titlecolor bold,#fff,#04a
set statuscolor #fff,#04a
set promptcolor #fff,#04a
set minicolor #fff,#04a
set errorcolor bold,#fff,#c00
set keycolor bold,#fff,#04a
set functioncolor #111
set numbercolor #444
set selectedcolor #fff,#05b
set spotlightcolor #111,#fd0
set scrollercolor #444
