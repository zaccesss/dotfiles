# Zacess Deep Contrast Light
# generated by scripts/build-themes.py from palette/zacess.json, do not edit by hand

set titlecolor bold,#fff,#048
set statuscolor #fff,#048
set promptcolor #fff,#048
set minicolor #fff,#048
set errorcolor bold,#fff,#c00
set keycolor bold,#fff,#048
set functioncolor #000
set numbercolor #444
set selectedcolor #fff,#909
set spotlightcolor #000,#ffa
set scrollercolor #444
