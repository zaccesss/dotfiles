# Zacess High Contrast Light
# generated by scripts/build-themes.py from palette/zacess.json, do not edit by hand
# a fragment zt copies into nano's own rc file: nano accepts set only there, never in an include

set titlecolor bold,#fff,#039
set statuscolor #fff,#039
set promptcolor #fff,#039
set minicolor #fff,#039
set errorcolor bold,#fff,#c00
set keycolor bold,#fff,#039
set functioncolor #000
set numbercolor #222
set selectedcolor #fff,#055
set spotlightcolor #000,#fd0
set scrollercolor #222
