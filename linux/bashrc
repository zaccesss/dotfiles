# shellcheck shell=bash
# temporary forwarding file: the real one moved to shell/. removed in a later release, once
# a machine has had time to re-run its bootstrap
# the link may be ~/.bashrc, so the shim's real path is resolved to find the clone
DOTFILES="$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")/shell"
if [[ $- == *i* && -z "$DOTFILES_MOVED_SHOWN" ]]; then
    echo "dotfiles moved to shell/: run setup/linux-bootstrap to re-point" >&2
    export DOTFILES_MOVED_SHOWN=1
fi
# shellcheck source=/dev/null
source "$DOTFILES/linux/bashrc"
