# =============================================================================
# dotfiles - Linux bash profile
# github.com/zaccesss/dotfiles - MIT licence
#
# topic loader - all aliases and functions live in linux/topics/*.sh.
# deploy on a new machine by appending a source line to ~/.bashrc:
#   echo "source $HOME/dev/github/repos/dotfiles/shell/linux/bashrc" >> ~/.bashrc
#
# zsh is the default shell on Linux now (see linux/zshrc); this bash profile stays
# as the fallback for a machine without zsh installed.
# =============================================================================

# bail out early for a non-interactive shell - a login shell running a single remote
# command (ssh host cmd, scp, rsync) has no terminal to print the banner to and needs
# none of the aliases, so loading the profile there only adds noise and cost
[[ $- == *i* ]] || return

DOTFILES="${DOTFILES:-$HOME/dev/github/repos/dotfiles/shell}"

for _f in "$DOTFILES/linux/topics/"*.sh; do
    # shellcheck disable=SC1090
    [[ -f "$_f" ]] && source "$_f"
done
unset _f

# =============================================================================
# Welcome banner - printed after all topics load so colour variables are ready
# =============================================================================

welcome
