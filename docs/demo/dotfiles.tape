# the welcome banner, the cmds cheat-sheet, then gs and glog in the demo project.
# Run through record.sh, which adds the theme and the output file.
Hide
Type "clear; exec /tmp/demo/start"
Enter
Sleep 4s
Show
Sleep 2s
Type "cmds"
Sleep 400ms
Enter
Sleep 3s
Space
Sleep 2s
Type "q"
Sleep 800ms
Type "gs"
Sleep 400ms
Enter
Sleep 2s
Type "glog"
Sleep 400ms
Enter
Sleep 2.5s
Screenshot "/tmp/demo/shots/dotfiles.png"
Sleep 1s
