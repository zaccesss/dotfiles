# Zacess Deep Contrast Light: the colours of the terminal theme of the same name from
# github.com/zacesshq/themes, plus the window settings shared by every recording here.
# record.sh sources this file before a scene, so each scene is recorded once per theme.
Set Shell "zsh"
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 18
Set Width 1400
Set Height 980
Set Padding 24
Set TypingSpeed 40ms
Set CursorBlink false
Set Theme {"name": "Zacess Deep Contrast Light", "black": "#000000", "brightBlack": "#404040", "red": "#ca0000", "brightRed": "#d14100", "green": "#00892e", "brightGreen": "#00884f", "yellow": "#ad6500", "brightYellow": "#907300", "blue": "#0040ff", "brightBlue": "#0d00ff", "magenta": "#cd01cd", "brightMagenta": "#db009a", "cyan": "#016e78", "brightCyan": "#0178c1", "white": "#595959", "brightWhite": "#000000", "background": "#ffffff", "foreground": "#000000", "selection": "#f0f5ff", "cursor": "#000000", "cursorAccent": "#ffffff"}
